<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Payment Methods - InwZa Bookstore</title>
    <meta name="description" content="Manage your saved payment options for your account.">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body class="bg-white">

    <!-- ========== NAVBAR ========== -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top shadow-sm py-3">
        <div class="container d-flex align-items-center flex-wrap">
            <a class="navbar-brand d-lg-none mx-auto" href="/">
                <img src="/images/Logo.png" alt="InwZa Bookstore Logo" class="navbar-logo" width="100">
            </a>
            <button class="navbar-toggler border-0 position-absolute end-0 me-3 d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 col-lg-4">
                    <li class="nav-item"><a class="nav-link fw-bold text-dark" href="/products">All Products</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle fw-bold text-dark" href="#" id="categoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Categories</a>
                        <ul class="dropdown-menu border-0 shadow" aria-labelledby="categoryDropdown">
                            <% navCategories.forEach(cat => { %>
                            <li><a class="dropdown-item" href="/category/<%= categorySlug(cat) %>"><%= cat.category_name %></a></li>
                            <% }); %>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-primary fw-bold" href="/categories">View All Categories</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle fw-bold text-dark" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">More</a>
                        <ul class="dropdown-menu border-0 shadow" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" href="/contact">Contact</a></li>
                            <li><a class="dropdown-item" href="/account/profile">Account</a></li>
                            <li><a class="dropdown-item" href="/cart">Cart</a></li>
                        </ul>
                    </li>
                </ul>

                <div class="d-none d-lg-flex col-lg-4 justify-content-center">
                    <a class="navbar-brand m-0" href="/">
                        <img src="/images/Logo.png" alt="InwZa Bookstore Logo" class="navbar-logo" width="100">
                    </a>
                </div>

                <div class="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center ms-lg-auto col-lg-4 justify-content-lg-end gap-2">
                    <form action="/search" method="GET" class="d-flex position-relative my-2 my-lg-0">
                        <input name="q" class="form-control rounded-pill pe-5 bg-light border-0 w-100" type="search" placeholder="Search products..." aria-label="Search">
                        <button type="submit" class="btn position-absolute top-50 end-0 translate-middle-y border-0 p-0 me-3">
                            <i class="bi bi-search text-muted"></i>
                        </button>
                    </form>
                    <a href="/cart" class="btn btn-outline-dark rounded-pill px-3 mt-2 mt-lg-0 position-relative"><i class="bi bi-cart3 fs-5"></i><% if (typeof cartCount !== 'undefined' && cartCount > 0) { %><span class="cart-badge badge bg-primary rounded-pill position-absolute" style="font-size:0.6rem;top:-5px;right:-5px;"><%= cartCount %></span><% } %></a>
                    <% if (typeof user !== 'undefined' && user) { %>
                        <div class="dropdown mt-2 mt-lg-0">
                            <a class="btn btn-outline-dark rounded-pill px-4 dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i> <%= user.username %>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow">
                                <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                                <li><a class="dropdown-item fw-bold text-primary" href="/admin"><i class="bi bi-shield-lock me-1"></i>Admin Dashboard</a></li>
                                <% } %>
                                <li><a class="dropdown-item" href="/account/profile">Profile</a></li>
                                <li><a class="dropdown-item" href="/account/orders">Order History</a></li>
                                <li><a class="dropdown-item" href="/account/wishlist">Wishlist</a></li>
                                <li><a class="dropdown-item" href="/account/addresses">Address Book</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="/auth/logout">Logout</a></li>
                            </ul>
                        </div>
                    <% } else { %>
                    <a href="/auth/login" class="btn btn-primary rounded-pill px-4 mt-2 mt-lg-0">Login</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- ========== HEADER SECTION ========== -->
    <section class="payment-hero text-center py-5 bg-light" id="payment-header">
        <div class="container">
            <h1 class="display-5 fw-bold">Manage Payment Methods</h1>
            <p class="text-muted fs-5">Add, remove, or set your default payment options.</p>
            <div class="mt-4">
                <a href="/account/profile" class="btn btn-outline-dark rounded-pill px-4"><i class="bi bi-arrow-left me-2"></i>Back to Profile</a>
            </div>
        </div>
    </section>

    <!-- ========== ALERTS ========== -->
    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger alert-dismissible fade show rounded-pill" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <% } %>
                <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success alert-dismissible fade show rounded-pill" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- ========== FEATURES LIST: SAVED CARDS ========== -->
    <section class="saved-cards-section py-5" id="saved-cards">
        <div class="container text-center">
            <h2 class="fw-bold mb-5">Your saved cards</h2>

            <!-- Database Saved Cards Only -->
            <% if (typeof paymentMethods !== 'undefined' && paymentMethods.length > 0) { %>
                <% paymentMethods.forEach(function(pm, index) { %>
                <div class="card-entry mx-auto text-start d-flex align-items-center flex-column flex-md-row gap-4 mb-3 <%= pm.is_default ? 'border-primary shadow-sm' : '' %>" style="max-width: 800px; padding: 25px; border: 1px solid <%= pm.is_default ? '#0d6efd' : '#eee' %>; border-radius: 16px;">
                    <div class="card-icon d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background: #f8f9fa; border-radius: 50%;">
                        <i class="bi bi-credit-card fs-2 text-secondary"></i>
                    </div>
                    <div class="flex-grow-1">
                        <span class="card-brand fw-bold text-uppercase text-secondary fs-6"><%= pm.provider %></span>
                        <h4 class="mb-1 fw-bold">Ending in <%= pm.card_number_masked.slice(-4) %></h4>
                        <span class="text-muted"><i class="bi bi-person me-1"></i><%= pm.cardholder_name %> &bull; Expires <%= pm.expiry_date %></span>
                        <% if (pm.is_default) { %>
                            <span class="badge bg-primary ms-2 rounded-pill px-3 py-2"><i class="bi bi-star-fill me-1"></i> Default</span>
                        <% } %>
                        <div class="d-flex gap-3 mt-4 flex-wrap align-items-center border-top pt-3">
                            <button type="button" form="delete-pm-<%= pm.payment_method_id %>" class="btn btn-outline-danger rounded-pill px-4 btn-sm fw-bold" onclick="if(confirm('Delete this payment method?')) document.getElementById('delete-pm-<%= pm.payment_method_id %>').submit();"><i class="bi bi-trash"></i> Remove</button>
                            <% if (!pm.is_default) { %>
                            <button type="button" form="default-pm-<%= pm.payment_method_id %>" class="btn btn-light rounded-pill px-4 btn-sm fw-bold text-dark border" onclick="document.getElementById('default-pm-<%= pm.payment_method_id %>').submit();">Make default <i class="bi bi-check2-circle ms-1"></i></button>
                            <% } %>
                        </div>
                    </div>
                </div>
                <% }); %>
            <% } else { %>
                <div class="text-center py-5 bg-light rounded-4 mx-auto" style="max-width: 800px; border: 2px dashed #dee2e6;">
                    <i class="bi bi-wallet2 display-1 text-muted opacity-50"></i>
                    <h3 class="mt-4 fw-bold">No payment methods saved</h3>
                    <p class="text-muted fs-5">Add a new credit or debit card below to ensure faster checkout next time.</p>
                </div>
            <% } %>

            <!-- Hidden action forms for methods -->
            <% if (typeof paymentMethods !== 'undefined') { %>
                <% paymentMethods.forEach(function(pm) { %>
                    <form id="default-pm-<%= pm.payment_method_id %>" action="/account/payment-methods/default/<%= pm.payment_method_id %>" method="POST" style="display:none;"></form>
                    <form id="delete-pm-<%= pm.payment_method_id %>" action="/account/payment-methods/delete/<%= pm.payment_method_id %>" method="POST" style="display:none;"></form>
                <% }); %>
            <% } %>

        </div>
    </section>

    <!-- ========== CTA SECTION: ADD NEW METHOD ========== -->
    <section class="payment-cta py-5 bg-light" id="cta-add-method">
        <div class="container">
            <div class="cta-box mx-auto text-center" style="max-width: 700px; padding: 50px; background: #fff; border-radius: 24px; box-shadow: 0 15px 40px rgba(0,0,0,0.06);">
                <div class="mb-4 d-inline-block p-3 rounded-circle bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-plus-circle-fill display-5"></i>
                </div>
                <h2 class="fw-bold mb-2">Add a new payment method</h2>
                <p class="text-muted mb-5">We protect your payment information with industry-leading encryption.</p>
                
                <form id="add-payment-form" action="/account/payment-methods/add" method="POST" class="text-start">
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark">Provider</label>
                            <select class="form-select form-select-lg rounded-pill bg-light border-0 px-4" name="provider">
                                <option value="Visa">Visa</option>
                                <option value="Mastercard">Mastercard</option>
                                <option value="American Express">American Express</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark">Cardholder Name</label>
                            <input type="text" class="form-control form-control-lg rounded-pill bg-light border-0 px-4" name="cardholder_name" placeholder="John Doe" required>
                        </div>
                    </div>
                    <div class="row g-4 mb-5">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark">Card Number</label>
                            <input type="text" class="form-control form-control-lg rounded-pill bg-light border-0 px-4" name="card_number" placeholder="**** **** **** ****" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark">Expiry Date</label>
                            <input type="text" class="form-control form-control-lg rounded-pill bg-light border-0 px-4" name="expiry_date" placeholder="MM/YY" required>
                        </div>
                    </div>
                    <div class="d-grid mt-2">
                        <button type="submit" class="btn btn-dark btn-lg rounded-pill py-3 fw-bold fs-5 shadow-sm">Save Payment Method</button>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- ========== FOOTER ========== -->
    <footer class="site-footer py-5 border-top bg-white" id="site-footer">
        <div class="container text-center">
            <p class="mb-0 text-muted">&copy; 2026 InwZa Bookstore. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
