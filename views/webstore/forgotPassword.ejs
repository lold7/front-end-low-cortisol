<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - InwZa Bookstore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body class="bg-white">

    <!-- Reusing Navbar styling but keeping it minimal for auth flow -->
    <nav class="navbar navbar-light bg-white sticky-top shadow-sm py-3 mb-5">
        <div class="container d-flex justify-content-center">
            <a class="navbar-brand m-0" href="/">
                <img src="/images/Logo.png" alt="InwZa Bookstore Logo" class="navbar-logo" width="100">
            </a>
        </div>
    </nav>

    <section class="container mt-5 pt-3 text-center">
        <h1 class="display-5 fw-bold mb-3">Reset your password</h1>
        <p class="text-muted">Enter the email address you registered with and we'll send you a link to reset your password.</p>
    </section>

    <section class="container my-5 py-4">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <form action="/auth/forgot-password" method="POST" id="forgot-password-form" class="mt-4 p-5 rounded-4 shadow-sm border">
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger rounded-3"><i class="bi bi-exclamation-octagon-fill me-2"></i> <%= error %></div>
                    <% } %>
                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="alert alert-success rounded-3"><i class="bi bi-envelope-check-fill me-2"></i> <%= success %></div>
                        <% if (typeof resetLink !== 'undefined' && resetLink) { %>
                            <!-- DEMO ONLY: stands in for the email the user would receive -->
                            <div class="border rounded-3 p-4 bg-light text-start">
                                <div class="small text-muted mb-2"><i class="bi bi-envelope me-1"></i> Simulated email to <b><%= email %></b></div>
                                <p class="mb-3">Click the link below to choose a new password. This link is valid for 30 minutes and can only be used once.</p>
                                <a href="<%= resetLink %>" class="btn btn-primary rounded-pill px-4 fw-bold">Reset My Password</a>
                            </div>
                        <% } %>
                        <div class="text-center mt-4">
                            <a href="/auth/login" class="text-muted small fw-bold text-decoration-none"><i class="bi bi-arrow-left me-1"></i> Back to Login</a>
                        </div>
                    <% } else { %>
                        <div class="mb-4">
                            <label class="form-label fw-bold small">Email address</label>
                            <input type="email" name="email" class="form-control bg-light border-0 rounded-3 py-3" placeholder="Enter your registered email" required>
                        </div>
                        <div class="d-grid mt-5">
                            <button type="submit" class="btn btn-primary rounded-pill py-3 fw-bold fs-5 shadow-sm">Send Reset Link</button>
                        </div>
                        <div class="text-center mt-4">
                            <a href="/auth/login" class="text-muted small fw-bold text-decoration-none"><i class="bi bi-arrow-left me-1"></i> Back to Login</a>
                        </div>
                    <% } %>
                </form>
            </div>
        </div>
    </section>

    <footer class="container py-5 mt-5 border-top">
        <div class="text-center text-muted small pt-2">
            <p>&copy; 2026 InwZa Bookstore. All rights reserved.</p>
        </div>
    </footer>

</body>
</html>
