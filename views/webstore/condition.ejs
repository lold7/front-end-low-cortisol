<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Policies &amp; Conditions - InwZa Bookstore</title>
    <meta name="description" content="Returns, privacy, terms of service and cookie policy for shopping at InwZa Bookstore.">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body>

    <!-- ========== NAVBAR ========== -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top shadow-sm py-3">
        <div class="container d-flex align-items-center flex-wrap">

            <!-- Left: Logo on mobile (centered via CSS), Toggler on right -->
            <a class="navbar-brand d-lg-none mx-auto" href="/">
                <img src="/images/Logo.png" alt="InwZa Bookstore Logo" class="navbar-logo" width="100">
            </a>
            <button class="navbar-toggler border-0 position-absolute end-0 me-3 d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Desktop 3-column layout -->
            <div class="collapse navbar-collapse" id="mainNavbar">
                <!-- Left nav links -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 col-lg-4">
                    <li class="nav-item"><a class="nav-link fw-bold text-dark" href="/products">All Products</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle fw-bold text-dark" href="#" id="categoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Categories</a>
                        <ul class="dropdown-menu border-0 shadow" aria-labelledby="categoryDropdown">
                            <% navCategories.forEach(cat => { %>
                            <li><a class="dropdown-item" href="/category/<%= categorySlug(cat) %>"><%= cat.category_name %></a></li>
                            <% }); %>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-primary fw-bold" href="/categories">View All Categories</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle fw-bold text-dark" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">More</a>
                        <ul class="dropdown-menu border-0 shadow" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" href="/contact">Contact</a></li>
                            <li><a class="dropdown-item" href="/account/profile">Account</a></li>
                            <li><a class="dropdown-item" href="/cart">Cart</a></li>
                        </ul>
                    </li>
                </ul>

                <!-- Center logo (desktop only) -->
                <div class="d-none d-lg-flex col-lg-4 justify-content-center">
                    <a class="navbar-brand m-0" href="/">
                        <img src="/images/Logo.png" alt="InwZa Bookstore Logo" class="navbar-logo" width="100">
                    </a>
                </div>

                <!-- Right: search + button -->
                <div class="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center ms-lg-auto col-lg-4 justify-content-lg-end gap-2">
                    <form action="/search" method="GET" class="d-flex position-relative my-2 my-lg-0">
                        <input name="q" class="form-control rounded-pill pe-5 bg-light border-0 w-100" type="search" placeholder="Search products..." aria-label="Search">
                        <i class="bi bi-search position-absolute top-50 end-0 translate-middle-y me-3 text-muted"></i>
                    </form>
                    <a href="/cart" class="btn btn-outline-dark rounded-pill px-3 mt-2 mt-lg-0 position-relative"><i class="bi bi-cart3 fs-5"></i><% if (cartCount > 0) { %><span class="cart-badge badge bg-primary rounded-pill position-absolute" style="font-size:0.6rem;top:-5px;right:-5px;"><%= cartCount %></span><% } %></a>
                    <% if (user) { %>
                    <div class="dropdown mt-2 mt-lg-0">
                        <a class="btn btn-primary rounded-pill px-4 dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"><%= user.username %></a>
                        <ul class="dropdown-menu border-0 shadow">
                            <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                            <li><a class="dropdown-item fw-bold text-primary" href="/admin"><i class="bi bi-shield-lock me-1"></i>Admin Dashboard</a></li>
                            <% } %>
                            <li><a class="dropdown-item" href="/account/profile">Profile</a></li>
                            <li><a class="dropdown-item" href="/account/orders">Order History</a></li>
                            <li><a class="dropdown-item" href="/account/wishlist">Wishlist</a></li>
                            <li><a class="dropdown-item" href="/account/addresses">Address Book</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/auth/logout">Logout</a></li>
                        </ul>
                    </div>
                    <% } else { %>
                    <a href="/auth/login" class="btn btn-primary rounded-pill px-4 mt-2 mt-lg-0">Login</a>
                    <% } %>
                </div>
            </div>

        </div>
    </nav>

    <!-- ========== HEADER SECTION ========== -->
    <section class="already-hero text-center" id="already-hero">
        <div class="container">
            <h1>Policies &amp; Conditions</h1>
            <p>Everything you need to know about returns, privacy, and shopping with us</p>
        </div>
    </section>

    <!-- ========== POLICY SECTION ========== -->
    <section class="existing-section" id="policies">
        <div class="container text-center mb-5">
            <span class="section-label">Store policies</span>
            <h2>How we look after your orders</h2>
            <p class="section-subtitle">Last updated 2025</p>
        </div>

        <div class="container">
            <div class="row g-4 justify-content-center" style="max-width: 820px; margin: 0 auto;">
                <!-- Card 1: Returns -->
                <div class="col-md-6" id="returns" style="scroll-margin-top: 110px;">
                    <div class="feature-card">
                        <div>
                            <span class="card-label">Returns</span>
                            <h3>Returns &amp; refunds</h3>
                            <ul class="card-desc ps-3 mb-0">
                                <li>Return any book within 30 days of purchase, as long as it is in its original condition.</li>
                                <li>Opened or damaged books may be eligible for an exchange instead of a refund.</li>
                                <li>Return shipping is free on qualifying items.</li>
                                <li>Once we receive your return, refunds go back to your original payment method within five business days.</li>
                            </ul>
                        </div>
                        <a href="/contact" class="card-action">Request a return <i class="bi bi-chevron-right"></i></a>
                    </div>
                </div>
                <!-- Card 2: Privacy -->
                <div class="col-md-6" id="privacy" style="scroll-margin-top: 110px;">
                    <div class="feature-card">
                        <div>
                            <span class="card-label">Privacy</span>
                            <h3>Privacy policy</h3>
                            <ul class="card-desc ps-3 mb-0">
                                <li>We store your name, email, phone number, and delivery addresses only to run your account and deliver your orders.</li>
                                <li>Passwords are stored as encrypted hashes and are never visible to our staff.</li>
                                <li>We never sell or share your personal information with third parties for marketing.</li>
                                <li>You can update your details anytime from your Account page.</li>
                            </ul>
                        </div>
                        <a href="/account/profile" class="card-action">Manage account <i class="bi bi-chevron-right"></i></a>
                    </div>
                </div>
                <!-- Card 3: Terms -->
                <div class="col-md-6" id="terms" style="scroll-margin-top: 110px;">
                    <div class="feature-card">
                        <div>
                            <span class="card-label">Terms</span>
                            <h3>Terms of service</h3>
                            <ul class="card-desc ps-3 mb-0">
                                <li>You need an account to place an order, and you are responsible for keeping your login details safe.</li>
                                <li>Prices and stock are shown at the time you order; an order is confirmed once it has been placed successfully.</li>
                                <li>We may cancel an order if an item becomes unavailable, and any payment will be refunded in full.</li>
                                <li>Order status can be followed in your Order History.</li>
                            </ul>
                        </div>
                        <a href="/account/orders" class="card-action">View order history <i class="bi bi-chevron-right"></i></a>
                    </div>
                </div>
                <!-- Card 4: Cookies -->
                <div class="col-md-6" id="cookies" style="scroll-margin-top: 110px;">
                    <div class="feature-card">
                        <div>
                            <span class="card-label">Cookies</span>
                            <h3>Cookie settings</h3>
                            <ul class="card-desc ps-3 mb-0">
                                <li>We use a single session cookie to keep you signed in and remember your cart.</li>
                                <li>We do not use advertising or third-party tracking cookies.</li>
                                <li>Blocking cookies in your browser will stop login and the cart from working.</li>
                            </ul>
                        </div>
                        <a href="/faq" class="card-action">Read the FAQ <i class="bi bi-chevron-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <% if (!user) { %>
    <!-- ========== ACCOUNT SECTION (guests only) ========== -->
    <section class="existing-section pt-0" id="feature-list">
        <div class="container text-center mb-5">
            <span class="section-label">Existing</span>
            <h2>Already have an account</h2>
            <p class="section-subtitle">Sign in to track orders and request returns</p>
        </div>

        <div class="container">
            <div class="row g-4 justify-content-center" style="max-width: 820px; margin: 0 auto;">
                <!-- Card 1: Log in -->
                <div class="col-md-6">
                    <div class="feature-card">
                        <div>
                            <span class="card-label">Access</span>
                            <h3>Log in to your account</h3>
                            <p class="card-desc">Continue where you left off</p>
                        </div>
                        <a href="/auth/login" class="card-action">Login <i class="bi bi-chevron-right"></i></a>
                    </div>
                </div>
                <!-- Card 2: Sign Up -->
                <div class="col-md-6">
                    <div class="feature-card">
                        <div>
                            <span class="card-label">New</span>
                            <h3>Create a new account here</h3>
                            <p class="card-desc">Join us and start exploring</p>
                        </div>
                        <a href="/auth/register" class="card-action">Sign Up <i class="bi bi-chevron-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <% } %>

    <!-- ========== FOOTER ========== -->
    <footer class="site-footer py-5" id="site-footer">
        <div class="container">
            <div class="footer-inner">
                <div class="row">
                    <!-- Left column: Address & Contact -->
                    <div class="col-12 col-md-4 mb-4 mb-md-0">
                        <h6>Address</h6>
                        <p class="mb-3">Level 2, 45 King Street, Sydney NSW 2000</p>
                        <h6>Contact</h6>
                        <p class="mb-1"><a href="tel:18005550123">1800 555 0123</a></p>
                        <p><a href="mailto:hello@minimalistbookstore.com">hello@minimalistbookstore.com</a></p>

                        <div class="footer-social mt-3">
                            <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                            <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                            <a href="#" aria-label="Twitter X"><i class="bi bi-twitter-x"></i></a>
                            <a href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                            <a href="#" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                        </div>
                    </div>

                    <!-- Center column: Navigation links -->
                    <div class="col-6 col-md-4 footer-links">
                        <a href="/products">All products</a>
                        <a href="/categories">Categories</a>
                        <a href="/contact">Contact us</a>
                        <a href="#">About us</a>
                        <a href="/account/orders">Order history</a>
                    </div>

                    <!-- Right column: More links -->
                    <div class="col-6 col-md-4 footer-links">
                        <a href="/account/wishlist">Wishlist</a>
                        <a href="/account/profile">Account</a>
                        <a href="/cart">Cart</a>
                        <a href="/faq">FAQ</a>
                        <a href="/condition#returns">Returns</a>
                    </div>
                </div>
            </div>

            <!-- Bottom bar -->
            <div class="footer-bottom d-flex flex-column flex-sm-row justify-content-between align-items-center">
                <p class="mb-2 mb-sm-0">&copy; 2025 Minimalist Bookstore. All rights reserved.</p>
                <div class="d-flex gap-3">
                    <a href="/condition#privacy">Privacy policy</a>
                    <a href="/condition#terms">Terms of service</a>
                    <a href="/condition#cookies">Cookie settings</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/cart.js"></script>
    <script src="/js/wishlist.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>