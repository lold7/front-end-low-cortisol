<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - InwZa Bookstore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body class="bg-white">

    <!-- Reusing Navbar styling but keeping it minimal for auth flow -->
    <nav class="navbar navbar-light bg-white sticky-top shadow-sm py-3 mb-5">
        <div class="container d-flex justify-content-center">
            <a class="navbar-brand m-0" href="/">
                <img src="/images/Logo.png" alt="InwZa Bookstore Logo" class="navbar-logo" width="100">
            </a>
        </div>
    </nav>

    <section class="container mt-5 pt-3 text-center">
        <h1 class="display-5 fw-bold mb-3">Choose a new password</h1>
        <p class="text-muted">Enter your new password below. It must be at least 8 characters long.</p>
    </section>

    <section class="container my-5 py-4">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <% if (typeof token !== 'undefined' && token) { %>
                <form action="/auth/reset-password/<%= token %>" method="POST" id="reset-password-form" class="mt-4 p-5 rounded-4 shadow-sm border">
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger rounded-3"><i class="bi bi-exclamation-octagon-fill me-2"></i> <%= error %></div>
                    <% } %>
                    <div class="mb-4">
                        <label class="form-label fw-bold small">New Password</label>
                        <input type="password" name="new_password" class="form-control bg-light border-0 rounded-3 py-3" placeholder="At least 8 characters" minlength="8" autocomplete="new-password" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold small">Confirm New Password</label>
                        <input type="password" name="confirm_password" class="form-control bg-light border-0 rounded-3 py-3" placeholder="Re-enter your new password" minlength="8" autocomplete="new-password" required>
                    </div>
                    <div class="d-grid mt-5">
                        <button type="submit" class="btn btn-primary rounded-pill py-3 fw-bold fs-5 shadow-sm">Reset Password</button>
                    </div>
                    <div class="text-center mt-4">
                        <a href="/auth/login" class="text-muted small fw-bold text-decoration-none"><i class="bi bi-arrow-left me-1"></i> Back to Login</a>
                    </div>
                </form>
                <% } else { %>
                <div class="mt-4 p-5 rounded-4 shadow-sm border">
                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="alert alert-success rounded-3"><i class="bi bi-check-circle-fill me-2"></i> <%= success %> <a href="/auth/login" class="fw-bold">Login here</a></div>
                    <% } else { %>
                        <div class="alert alert-danger rounded-3"><i class="bi bi-exclamation-octagon-fill me-2"></i> <%= (typeof error !== 'undefined' && error) ? error : 'This reset link is invalid or has expired.' %></div>
                        <div class="d-grid mt-4">
                            <a href="/auth/forgot-password" class="btn btn-primary rounded-pill py-3 fw-bold fs-5 shadow-sm">Request a New Link</a>
                        </div>
                    <% } %>
                </div>
                <% } %>
            </div>
        </div>
    </section>

    <footer class="container py-5 mt-5 border-top">
        <div class="text-center text-muted small pt-2">
            <p>&copy; 2026 InwZa Bookstore. All rights reserved.</p>
        </div>
    </footer>

</body>
</html>
