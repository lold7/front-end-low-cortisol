<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Admin Account</title>
    <meta name="description" content="Register a new Administrator for the Bookstore">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-login-body">

    <div class="login-card mx-3 mx-sm-0" style="max-width: 480px; padding: 2.5rem !important;">
        <div class="login-card-body">
            <div class="login-icon-box">
                <i class="bi bi-person-plus-fill"></i>
            </div>
            <h3 class="text-center fw-bold mb-2">Create New Admin</h3>
            <p class="text-center text-muted mb-4 font-size-14">Set up a new administrative account.</p>

            <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger py-2 font-size-14"><i class="bi bi-exclamation-octagon me-1"></i> <%= error %></div>
            <% } %>

            <form action="/backoffice/register" method="POST">
                <div class="mb-3">
                    <label class="form-label fw-bold font-size-12 text-dark mb-1">Username</label>
                    <div class="position-relative">
                        <i class="bi bi-person login-input-icon"></i>
                        <input type="text" name="username" class="form-control login-form-control py-2 text-dark border-light-subtle" placeholder="AdminUsername" required>
                    </div>
                </div>
                
                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label fw-bold font-size-12 text-dark mb-1">Email Address</label>
                        <div class="position-relative">
                            <i class="bi bi-envelope login-input-icon"></i>
                            <input type="email" name="email" class="form-control login-form-control py-2 text-dark border-light-subtle px-5" placeholder="admin@bookstore.com" required>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label fw-bold font-size-12 text-dark mb-1">Phone (Optional)</label>
                        <div class="position-relative">
                            <i class="bi bi-telephone login-input-icon"></i>
                            <input type="text" name="phone" class="form-control login-form-control py-2 text-dark border-light-subtle px-5" placeholder="Phone Number">
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold font-size-12 text-dark mb-1">Password</label>
                    <div class="position-relative">
                        <i class="bi bi-lock login-input-icon"></i>
                        <input type="password" name="password" class="form-control login-form-control py-2 text-dark border-light-subtle" placeholder="Create a strong password" required>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold font-size-12 text-dark mb-1">Confirm Password</label>
                    <div class="position-relative">
                        <i class="bi bi-check2-circle login-input-icon"></i>
                        <input type="password" name="confirm_password" class="form-control login-form-control py-2 text-dark border-light-subtle" placeholder="Repeat the password" required>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm">Register Admin</button>
            </form>
        </div>
        <div class="login-card-footer mt-4 pb-0 text-center border-0">
            <a href="/backoffice/login" class="text-primary text-decoration-none fw-medium font-size-14"><i class="bi bi-arrow-left me-1"></i> Back to Login</a>
        </div>
    </div>

    <div class="mt-4 text-center">
        <p class="text-muted mb-0" style="font-size: 0.72rem;">&copy; 2026 Bookstore Inc. All rights reserved.</p>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
