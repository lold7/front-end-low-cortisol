<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Management</title>
    <meta name="description" content="Manage and fulfill customer book orders.">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body style="background-color: var(--admin-bg);">
    <div class="admin-layout">
        <!-- ========== SIDEBAR ========== -->
        <aside class="admin-sidebar border-end bg-white">
            <div class="sidebar-header border-bottom">
                <div class="logo d-flex align-items-center gap-2">
                    <img src="/images/Logo.png" alt="InwZa Bookstore" width="36" height="36" style="object-fit: contain;">
                    <div>
                        <h5 class="m-0 fw-bold fs-6">InwZa Bookstore</h5>
                        <small class="text-muted" style="font-size: 0.72rem;">Orders</small>
                    </div>
                </div>
            </div>
            <div class="sidebar-nav mt-4">
                <ul class="nav flex-column gap-1 px-3">
                    <li class="nav-item">
                        <a href="/admin" class="nav-link"><i class="bi bi-grid-1x2"></i> Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a href="/backoffice/categories" class="nav-link"><i class="bi bi-diagram-3"></i> Category</a>
                    </li>
                    <li class="nav-item">
                        <a href="/backoffice/products" class="nav-link"><i class="bi bi-journal-check"></i> Product</a>
                    </li>
                    <li class="nav-item">
                        <a href="/backoffice/inventory" class="nav-link"><i class="bi bi-box-seam"></i> Inventory</a>
                    </li>
                    <li class="nav-item">
                        <a href="/backoffice/orders" class="nav-link active"><i class="bi bi-receipt-cutoff"></i> Orders</a>
                    </li>
                    <li class="nav-item">
                        <a href="/backoffice/customers" class="nav-link"><i class="bi bi-people"></i> Customers</a>
                    </li>
                </ul>
            </div>
        </aside>

        <!-- ========== MAIN CONTENT ========== -->
        <main class="admin-main">
            <!-- Top Navbar -->
            <header class="admin-topbar bg-white border-bottom d-flex align-items-center justify-content-between px-4 sticky-top">
                <h4 class="m-0 fw-bold">Orders</h4>
                <div class="d-flex align-items-center gap-4">
                    <div class="dropdown user-profile border-start ps-4" style="cursor: pointer;">
                        <div class="d-flex flex-row align-items-center gap-2" data-bs-toggle="dropdown" aria-expanded="false" role="button">
                            <h6 class="m-0 fw-bold font-size-14"><%= typeof user !== 'undefined' && user ? user.username : 'Admin' %> <i class="bi bi-chevron-down ms-1 text-muted" style="font-size: 0.75rem;"></i></h6>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                            <li><a class="dropdown-item py-2 font-size-14" href="/"><i class="bi bi-shop me-2 text-muted"></i>Back to webstore</a></li>
                            <li><a class="dropdown-item py-2 font-size-14" href="/backoffice/profile"><i class="bi bi-person me-2 text-muted"></i>Admin Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item py-2 font-size-14 text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Header Area -->
            <div class="d-flex align-items-center justify-content-between px-5 pt-5 pb-4">
                <div>
                    <h2 class="m-0 fw-bold fs-3">Order Management</h2>
                    <p class="text-muted m-0 font-size-14 mt-1">Manage and fulfill customer book orders.</p>
                </div>

            </div>

            <!-- Main Content Container -->
            <div class="px-5 pb-5 pt-0" style="max-width: 1300px;">
                
                <!-- Filter Bar Card -->
                <div class="admin-card p-2 mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3 shadow-sm border-0">
                    <!-- Tabs -->
                    <div class="order-tabs d-flex align-items-center gap-1">
                        <a href="/backoffice/orders" class="tab-link <%= typeof statusFilter === 'undefined' || !statusFilter ? 'active' : '' %>">All Orders</a>
                        <a href="/backoffice/orders?status=pending" class="tab-link <%= typeof statusFilter !== 'undefined' && statusFilter === 'pending' ? 'active' : '' %>">Pending</a>
                        <a href="/backoffice/orders?status=processing" class="tab-link <%= typeof statusFilter !== 'undefined' && statusFilter === 'processing' ? 'active' : '' %>">Processing</a>
                        <a href="/backoffice/orders?status=completed" class="tab-link <%= typeof statusFilter !== 'undefined' && statusFilter === 'completed' ? 'active' : '' %>">Completed</a>
                        <a href="/backoffice/orders?status=cancelled" class="tab-link <%= typeof statusFilter !== 'undefined' && statusFilter === 'cancelled' ? 'active' : '' %>">Cancelled</a>
                    </div>
                    
                    <!-- Search & Filter Controls -->
                    <div class="d-flex align-items-center gap-3">
                        <form action="/backoffice/orders" method="GET" class="search-bar position-relative m-0" style="width: 250px;">
                            <% if (typeof statusFilter !== 'undefined' && statusFilter) { %>
                                <input type="hidden" name="status" value="<%= statusFilter %>">
                            <% } %>
                            <i class="bi bi-search position-absolute top-50 translate-middle-y ms-3 text-muted"></i>
                            <input type="text" name="search" class="form-control ps-5 text-dark" placeholder="Search order ID, customer..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                        </form>
                    </div>
                </div>

                <!-- Orders Table Card -->
                <div class="admin-card p-0 overflow-hidden border-0 shadow-sm rounded-4">
                    <div class="table-responsive">
                        <table class="table admin-table mb-0 align-middle table-hover">
                            <thead class="bg-white text-muted border-bottom">
                                <tr>
                                    <th class="ps-4 text-uppercase fw-semibold" style="letter-spacing: 0.05em; font-size: 0.72rem;">Order ID</th>
                                    <th class="text-uppercase fw-semibold" style="letter-spacing: 0.05em; font-size: 0.72rem;">Customer</th>
                                    <th class="text-uppercase fw-semibold" style="letter-spacing: 0.05em; font-size: 0.72rem;">Date</th>
                                    <th class="text-uppercase fw-semibold" style="letter-spacing: 0.05em; font-size: 0.72rem;">Total</th>
                                    <th class="text-uppercase fw-semibold" style="letter-spacing: 0.05em; font-size: 0.72rem;">Payment</th>
                                    <th class="text-uppercase fw-semibold" style="letter-spacing: 0.05em; font-size: 0.72rem;">Status</th>
                                    <th class="text-end pe-4 text-uppercase fw-semibold" style="letter-spacing: 0.05em; font-size: 0.72rem;">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white">
                                <% if (typeof orders !== 'undefined' && orders && orders.length > 0) { %>
                                <% orders.forEach(function(order) { %>
                                <%
                                    var custName = order.username || 'Unknown';
                                    var initials = custName.split(' ').map(function(w) { return w.charAt(0).toUpperCase(); }).join('').substring(0, 2);
                                    var orderDate = order.created_at ? new Date(order.created_at) : new Date();
                                    var monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
                                    var dateStr = monthNames[orderDate.getMonth()] + ' ' + orderDate.getDate() + ', ' + orderDate.getFullYear();
                                    var statusClass = 'status-pending';
                                    if (order.status === 'completed') statusClass = 'status-completed';
                                    else if (order.status === 'cancelled') statusClass = 'status-cancelled';
                                    else if (order.status === 'processing') statusClass = 'status-processing';
                                %>
                                <tr>
                                    <td class="ps-4 py-3 border-bottom"><a href="#" class="text-decoration-none fw-medium text-primary">#ORD-<%= String(order.order_id).padStart(3, '0') %></a></td>
                                    <td class="border-bottom">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="customer-avatar bg-jd text-primary fw-bold" style="width: 32px; height: 32px; font-size: 0.75rem;"><%= initials %></div>
                                            <h6 class="m-0 fw-medium font-size-14 text-dark"><%= custName %></h6>
                                        </div>
                                    </td>
                                    <td class="text-secondary font-size-14 border-bottom"><%= dateStr %></td>
                                    <td class="text-dark font-size-14 fw-semibold border-bottom">$<%= Number(order.total_price).toFixed(2) %></td>
                                    <td class="text-secondary font-size-14 border-bottom"><%= order.payment_method || 'N/A' %></td>
                                    <td class="border-bottom">
                                        <form action="/backoffice/orders/status/<%= order.order_id %>" method="POST" class="d-inline">
                                            <select name="status" class="badge <%= statusClass %> rounded-pill px-3 py-1 fw-normal border-0" onchange="this.form.submit()" style="cursor:pointer; appearance: auto;">
                                                <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                                <option value="processing" <%= order.status === 'processing' ? 'selected' : '' %>>Processing</option>
                                                <option value="completed" <%= order.status === 'completed' ? 'selected' : '' %>>Completed</option>
                                                <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                                            </select>
                                        </form>
                                    </td>
                                    <td class="text-end pe-4 border-bottom">
                                        <a href="#" class="text-decoration-none fw-medium text-primary font-size-14 view-order-btn" data-order-id="<%= order.order_id %>">View</a>
                                    </td>
                                </tr>
                                <% }); %>
                                <% } else { %>
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">No orders found.</td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>


                </div>

            </div>
            
            <!-- Order Details Modal -->
            <div class="modal fade" id="orderDetailsModal" tabindex="-1" aria-labelledby="orderDetailsModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content border-0 shadow">
                        <div class="modal-header border-bottom">
                            <h5 class="modal-title fw-bold" id="orderDetailsModalLabel">Order Summary</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div id="orderItemsLoading" class="text-center py-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                            <div id="orderItemsContainer" class="d-none">
                                <table class="table align-middle">
                                    <thead class="text-muted" style="font-size: 0.85rem;">
                                        <tr>
                                            <th>Product</th>
                                            <th>Price</th>
                                            <th>Qty</th>
                                            <th class="text-end">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody id="orderItemsTableBody" class="border-top-0">
                                        <!-- Items will be loaded here via AJAX -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="modal-footer border-top-0 pt-0">
                            <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
            
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/backoffice.js"></script>
    <script>
        $(document).ready(function() {
            $('.view-order-btn').click(function(e) {
                e.preventDefault();
                const orderId = $(this).data('order-id');
                const modal = new bootstrap.Modal(document.getElementById('orderDetailsModal'));
                
                $('#orderItemsLoading').removeClass('d-none');
                $('#orderItemsContainer').addClass('d-none');
                $('#orderItemsTableBody').empty();
                
                modal.show();
                
                $.get('/backoffice/orders/api/' + orderId, function(res) {
                    if (res.success && res.details && res.details.length > 0) {
                        res.details.forEach(function(item) {
                            let images = item.product_images;
                            let imgUrl = '/images/placeholder.jpg';
                            if (images) {
                                try {
                                    const parsed = JSON.parse(images);
                                    if (parsed.length > 0) imgUrl = '/images/products/' + parsed[0];
                                } catch(e) {
                                    imgUrl = '/images/products/' + images;
                                }
                            }
                            const total = (Number(item.quantity) * Number(item.unit_price)).toFixed(2);
                            const row = `
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="${imgUrl}" alt="${item.product_name}" class="rounded object-fit-cover shadow-sm border" width="48" height="64">
                                            <h6 class="m-0 fw-medium font-size-14 text-dark">${item.product_name}</h6>
                                        </div>
                                    </td>
                                    <td class="text-secondary">$${Number(item.unit_price).toFixed(2)}</td>
                                    <td class="text-dark fw-medium">${item.quantity}</td>
                                    <td class="text-end text-dark fw-semibold">$${total}</td>
                                </tr>
                            `;
                            $('#orderItemsTableBody').append(row);
                        });
                        $('#orderItemsLoading').addClass('d-none');
                        $('#orderItemsContainer').removeClass('d-none');
                    } else {
                        $('#orderItemsLoading').addClass('d-none');
                        $('#orderItemsContainer').removeClass('d-none').html('<p class="text-center text-muted">No details found for this order.</p>');
                    }
                }).fail(function() {
                    $('#orderItemsLoading').addClass('d-none');
                    $('#orderItemsContainer').removeClass('d-none').html('<p class="text-center text-danger">Failed to load order details.</p>');
                });
            });
        });
    </script>
</body>
</html>