<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Product Management</title>
    <meta name="description" content="BookStore Admin Panel Product Management">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="admin-layout">
        <!-- ========== SIDEBAR ========== -->
        <aside class="admin-sidebar border-end bg-white">
            <div class="sidebar-header border-bottom">
                <div class="logo d-flex align-items-center gap-2">
                    <img src="/images/Logo.png" alt="InwZa Bookstore" width="36" height="36" style="object-fit: contain;">
                    <div>
                        <h5 class="m-0 fw-bold fs-6">InwZa Bookstore</h5>
                        <small class="text-muted" style="font-size: 0.72rem;">Products</small>
                    </div>
                </div>
            </div>
            <div class="sidebar-nav mt-4">
                <ul class="nav flex-column gap-1 px-3">
                    <li class="nav-item">
                        <a href="/admin" class="nav-link"><i class="bi bi-grid-1x2"></i> Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a href="/backoffice/categories" class="nav-link"><i class="bi bi-diagram-3"></i> Category</a>
                    </li>
                    <li class="nav-item">
                        <a href="/backoffice/products" class="nav-link active"><i class="bi bi-journal-check"></i> Product</a>
                    </li>
                    <li class="nav-item">
                        <a href="/backoffice/inventory" class="nav-link"><i class="bi bi-box-seam"></i> Inventory</a>
                    </li>
                    <li class="nav-item">
                        <a href="/backoffice/orders" class="nav-link"><i class="bi bi-receipt"></i> Orders</a>
                    </li>
                    <li class="nav-item">
                        <a href="/backoffice/customers" class="nav-link"><i class="bi bi-people"></i> Customers</a>
                    </li>
                </ul>
            </div>
        </aside>

        <!-- ========== MAIN CONTENT ========== -->
        <main class="admin-main">
            <!-- Top Navbar -->
            <header class="admin-topbar bg-white border-bottom d-flex align-items-center justify-content-between px-4 sticky-top">
                <h4 class="m-0 fw-bold">Products</h4>
                <div class="d-flex align-items-center gap-4">
                    <div class="dropdown user-profile border-start ps-4" style="cursor: pointer;">
                        <div class="d-flex flex-row align-items-center gap-2" data-bs-toggle="dropdown" aria-expanded="false" role="button">
                            <h6 class="m-0 fw-bold font-size-14"><%= typeof user !== 'undefined' && user ? user.username : 'Admin' %> <i class="bi bi-chevron-down ms-1 text-muted" style="font-size: 0.75rem;"></i></h6>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                            <li><a class="dropdown-item py-2 font-size-14" href="/"><i class="bi bi-shop me-2 text-muted"></i>Back to webstore</a></li>
                            <li><a class="dropdown-item py-2 font-size-14" href="/backoffice/profile"><i class="bi bi-person me-2 text-muted"></i>Admin Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item py-2 font-size-14 text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Dashboard Content Container -->
            <div class="p-4" style="max-width: 1400px;">

                <!-- Page Header & Actions -->
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
                    <div>
                        <h2 class="fw-bold mb-1 fs-3">Product Management</h2>
                        <p class="text-muted m-0 font-size-14">Manage your bookstore inventory efficiently</p>
                    </div>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger py-2 font-size-14"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %></div>
                <% } %>

                <!-- Filter Bar -->
                <div class="admin-card py-2 px-3 mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3 border-0">
                    <div class="d-flex align-items-center gap-3 flex-wrap w-100">
                        <form action="/backoffice/products" method="GET" class="d-flex align-items-center gap-2 w-100 flex-md-nowrap flex-wrap">
                            <div class="position-relative flex-grow-1" style="max-width: 300px;">
                                <i class="bi bi-search position-absolute text-muted" style="left: 12px; top: 50%; transform: translateY(-50%);"></i>
                                <input type="text" name="search" class="form-control form-control-sm border rounded-pill ps-5 py-2 font-size-14 bg-light" placeholder="Search by name or author..." value="<%= typeof searchKeyword !== 'undefined' && searchKeyword ? searchKeyword : '' %>">
                            </div>

                            <select name="category" class="form-select form-select-sm rounded-pill border py-2 px-3 font-size-14 bg-light text-muted" onchange="this.form.submit()" style="width: auto; min-width: 150px;">
                                <option value="">All Categories</option>
                                <% if (typeof categories !== 'undefined' && categories) { %>
                                <% categories.forEach(function(cat) { %>
                                <option value="<%= cat.category_id %>" <%= typeof selectedCategory !== 'undefined' && selectedCategory == cat.category_id ? 'selected' : '' %>><%= cat.category_name %></option>
                                <% }); %>
                                <% } %>
                            </select>
                            
                            <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 py-2 fw-medium d-none d-md-block">Search</button>

                            <% if ((typeof selectedCategory !== 'undefined' && selectedCategory) || (typeof searchKeyword !== 'undefined' && searchKeyword)) { %>
                            <a href="/backoffice/products" class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill py-2 px-3 fw-normal font-size-14 d-flex align-items-center gap-1 text-decoration-none">
                                Clear Filters <i class="bi bi-x-circle-fill text-primary ms-1"></i>
                            </a>
                            <% } %>
                        </form>
                    </div>
                </div>

                <!-- Table Container -->
                <div class="admin-card p-0 overflow-hidden border-0">
                    <div class="table-responsive">
                        <table class="table admin-table mb-0 align-middle table-hover">
                            <thead class="bg-white text-muted border-bottom">
                                <tr>
                                    <th class="ps-4 text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Image</th>
                                    <th class="text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Product Name</th>
                                    <th class="text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Author</th>
                                    <th class="text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Category</th>
                                    <th class="text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Price</th>
                                    <th class="text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Stock</th>
                                    <th class="text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Status</th>
                                    <th class="text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Attributes</th>
                                    <th class="pe-4 text-end text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
                                <% products.forEach(function(p) { %>
                                <%
                                    var images = [];
                                    if (p.product_images) {
                                        if (typeof p.product_images === 'string') {
                                            try { images = JSON.parse(p.product_images); } catch(e) { images = [p.product_images]; }
                                        } else if (Array.isArray(p.product_images)) {
                                            images = p.product_images;
                                        }
                                    }
                                    var firstImage = images.length > 0 ? images[0] : '';
                                    var attrs = '';
                                    var authorName = 'Unknown';
                                    if (p.product_attributes) {
                                        var attrObj = typeof p.product_attributes === 'string' ? JSON.parse(p.product_attributes) : p.product_attributes;
                                        if (attrObj && attrObj.format) {
                                            attrs = Array.isArray(attrObj.format) ? attrObj.format.join(', ') : attrObj.format;
                                        }
                                        if (attrObj && attrObj.author) {
                                            authorName = attrObj.author;
                                        }
                                    }
                                %>
                                <tr>
                                    <td class="ps-4">
                                        <div class="bg-light rounded p-2 d-flex align-items-center justify-content-center" style="width: 48px; height: 64px;">
                                            <% if (firstImage) { %>
                                            <img src="/images/products/<%= firstImage %>" alt="<%= p.product_name %>" class="img-fluid rounded shadow-sm" style="object-fit:cover; width: 100%; height: 100%;">
                                            <% } else { %>
                                            <i class="bi bi-image text-muted"></i>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td>
                                        <h6 class="m-0 fw-bold font-size-14 mb-1"><%= p.product_name %></h6>
                                        <small class="text-muted" style="font-size:0.75rem;">ID: #<%= p.product_id %></small>
                                    </td>
                                    <td class="text-dark font-size-14 fw-medium"><%= authorName %></td>
                                    <td><span class="badge rounded-pill fw-normal" style="background-color: #e0f2fe; color: #0284c7; padding: 0.35rem 0.7rem;"><%= p.category_name || 'N/A' %></span></td>
                                    <td class="fw-medium text-dark">$<%= Number(p.product_price).toFixed(2) %></td>
                                    <td class="text-dark font-size-14"><span class="<%= p.product_quantity <= 0 ? 'text-danger fw-bold' : '' %>"><%= p.product_quantity %></span> <span class="text-muted" style="font-size: 0.75rem;">in stock</span></td>
                                    <td>
                                        <% if (p.is_visible) { %>
                                            <span class="badge rounded-pill bg-success-subtle text-success fw-normal px-2 py-1"><i class="bi bi-eye-fill me-1"></i>Visible</span>
                                        <% } else { %>
                                            <span class="badge rounded-pill bg-secondary-subtle text-secondary fw-normal px-2 py-1"><i class="bi bi-eye-slash-fill me-1"></i>Hidden</span>
                                        <% } %>
                                    </td>
                                    <td class="text-muted font-size-14"><%= attrs || '-' %></td>
                                    <td class="pe-4 text-end text-nowrap">
                                        <form action="/backoffice/products/toggle/<%= p.product_id %>" method="POST" style="display:inline;">
                                            <button type="submit" class="btn btn-link <%= p.is_visible ? 'text-primary' : 'text-secondary' %> p-1 me-2 text-decoration-none" title="<%= p.is_visible ? 'Hide Product' : 'Show Product' %>">
                                                <i class="bi <%= p.is_visible ? 'bi-eye' : 'bi-eye-slash' %>"></i>
                                            </button>
                                        </form>
                                        <a href="/backoffice/inventory/<%= p.product_id %>" class="btn btn-link text-muted p-1 me-2 text-decoration-none"><i class="bi bi-pencil"></i></a>
                                        <form action="/backoffice/products/delete/<%= p.product_id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this product?')">
                                            <button type="submit" class="btn btn-link text-muted p-1 text-decoration-none"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                                <% }); %>
                                <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">No products found.</td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination Footer -->
                    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                    <div class="d-flex flex-wrap align-items-center justify-content-between p-4 border-top bg-white">
                        <span class="text-muted font-size-14 mb-2 mb-md-0">Showing <strong><%= products.length %></strong> out of <strong><%= totalProducts %></strong> results</span>
                        <ul class="admin-pagination pagination m-0 gap-1 d-flex align-items-center">
                            
                            <!-- Previous Button -->
                            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                <a class="page-link border-0 text-muted shadow-none bg-transparent" href="?category=<%= selectedCategory || '' %>&search=<%= typeof searchKeyword !== 'undefined' ? searchKeyword : '' %>&page=<%= currentPage - 1 %>">
                                    <i class="bi bi-chevron-left" style="font-size: 0.8rem;"></i>
                                </a>
                            </li>

                            <!-- Page Numbers -->
                            <% for(let i = 1; i <= totalPages; i++) { %>
                                <li class="page-item">
                                    <a class="page-link border-0 <%= currentPage === i ? 'bg-primary text-white rounded-3 px-3 py-1 shadow-sm' : 'text-muted bg-transparent px-3 py-1 shadow-none' %>" href="?category=<%= selectedCategory || '' %>&search=<%= typeof searchKeyword !== 'undefined' ? searchKeyword : '' %>&page=<%= i %>"><%= i %></a>
                                </li>
                            <% } %>

                            <!-- Next Button -->
                            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                <a class="page-link border-0 text-muted shadow-none bg-transparent" href="?category=<%= selectedCategory || '' %>&search=<%= typeof searchKeyword !== 'undefined' ? searchKeyword : '' %>&page=<%= currentPage + 1 %>">
                                    <i class="bi bi-chevron-right" style="font-size: 0.8rem;"></i>
                                </a>
                            </li>
                        </ul>
                    </div>
                    <% } else if (typeof totalProducts !== 'undefined' && totalProducts > 0) { %>
                    <div class="d-flex flex-wrap align-items-center p-4 border-top bg-white">
                        <span class="text-muted font-size-14 mb-2 mb-md-0">Showing <strong><%= products.length %></strong> results</span>
                    </div>
                    <% } %>
                </div>

            </div>
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/backoffice.js"></script>
</body>
</html>